      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List operational and sales tasks, optionally filtered by status, team or lead.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by task status, e.g. todo, doing, done."
            },
            "team": {
              "type": "string",
              "description": "Filter by team, e.g. sales or ops."
            },
            "lead_id": {
              "type": "string",
              "description": "Only tasks linked to this lead uuid."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 50, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
