        "description": "List confirmed trips departing within the next N days, soonest first. Use for operational priorities (D-1, D-3, D-7).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "description": "Days ahead to include (default 7, max 365)."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 50, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
